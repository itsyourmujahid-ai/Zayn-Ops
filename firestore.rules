rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. Core Authentication & Authorization Helpers
    // ==========================================
    
    // Check if client is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if user profile doc exists in database
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Fetch user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if authenticated user is the designated Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        (('email' in request.auth.token) && request.auth.token.email != null && request.auth.token.email.lower() == 'itsyourmujahid@gmail.com') ||
        (userDocExists() && getUserData().role == 'SUPER_ADMIN')
      );
    }

    // Check if authenticated user has Company Admin or Super Admin privileges
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && (
          getUserData().role == 'ADMIN' ||
          getUserData().role == 'admin'
        ))
      );
    }

    // Check if authenticated user account is active
    function isActive() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        !userDocExists() ||
        !('is_active' in getUserData()) ||
        getUserData().is_active == true
      );
    }

    // Get the user's company ID
    function getUserCompanyId() {
      return userDocExists() && ('company_id' in getUserData()) ? getUserData().company_id : 'company-bahwan-mge';
    }

    // Check if the user's company is active (or user is Super Admin)
    function isCompanyActive() {
      return isSuperAdmin() || (
        !userDocExists() ||
        !('company_id' in getUserData()) ||
        !exists(/databases/$(database)/documents/companies/$(getUserData().company_id)) ||
        get(/databases/$(database)/documents/companies/$(getUserData().company_id)).data.status == 'ACTIVE'
      );
    }

    // Check if a document belongs to the authenticated user's company
    function belongsToCompany(docData) {
      return isSuperAdmin() || (
        !('company_id' in docData) ||
        docData.company_id == getUserCompanyId()
      );
    }

    // Check if user has access to a specific lead
    function canAccessLead(leadId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/leads/$(leadId)) &&
          belongsToCompany(get(/databases/$(database)/documents/leads/$(leadId)).data) &&
          (
            isAdmin() ||
            get(/databases/$(database)/documents/leads/$(leadId)).data.assigned_to == request.auth.uid ||
            get(/databases/$(database)/documents/leads/$(leadId)).data.created_by == request.auth.uid
          )
        )
      );
    }

    // Enum validators
    function isValidStatus(status) {
      return status in ['New', 'Contacted', 'Interested', 'Meeting', 'Quotation', 'Negotiation', 'Won', 'Lost'];
    }

    function isValidPriority(priority) {
      return priority in ['Hot', 'Warm', 'Cold'];
    }

    function isValidFollowupStatus(status) {
      return status in ['pending', 'completed', 'rescheduled', 'cancelled'];
    }

    // ==========================================
    // 2. Companies Collection (/companies/{companyId})
    // ==========================================
    match /companies/{companyId} {
      // Super Admin can read all companies; Company members can read their own company
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && getUserCompanyId() == companyId)
      );

      // Super Admin only can create companies
      allow create: if isAuthenticated() && isSuperAdmin() &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0;

      // Super Admin can update any field; Company Admin can update profile info but NOT status
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          getUserCompanyId() == companyId &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
        )
      );

      // Super Admin only can delete/archive company records
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // ==========================================
    // 3. User Profiles Collection (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // Super Admin can read all users; Users can read profiles in their own company
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        !('company_id' in resource.data) ||
        resource.data.company_id == getUserCompanyId()
      );
      
      // Creating user profiles:
      // - Super Admin can create any profile
      // - Company Admin can create SALESMAN profiles strictly for their own company
      // - User can create their own profile on signup
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isAdmin() && 
          request.resource.data.company_id == getUserCompanyId() && 
          request.resource.data.role == 'SALESMAN'
        ) ||
        (
          request.auth.uid == userId && (
            request.resource.data.role != 'SUPER_ADMIN' ||
            (request.auth.token.email != null && request.auth.token.email.lower() == 'itsyourmujahid@gmail.com')
          )
        )
      );
      
      // Update profile:
      // - Super Admin can update any profile
      // - Company Admin can update profiles in their own company (cannot create Super Admin or change company_id)
      // - Users can update their own basic profile info
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          belongsToCompany(resource.data) &&
          resource.data.role != 'SUPER_ADMIN' &&
          request.resource.data.role != 'SUPER_ADMIN' &&
          (!('company_id' in request.resource.data) || request.resource.data.company_id == resource.data.company_id)
        ) ||
        (
          request.auth.uid == userId &&
          isActive() &&
          request.resource.data.role == resource.data.role &&
          (!('company_id' in request.resource.data) || request.resource.data.company_id == resource.data.company_id) &&
          (!('is_active' in request.resource.data) || request.resource.data.is_active == resource.data.is_active)
        )
      );
      
      // Delete user: Super Admin or Company Admin (for own company)
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && belongsToCompany(resource.data) && resource.data.role != 'SUPER_ADMIN')
      );
    }

    // ==========================================
    // 4. Leads Collection (/leads/{leadId})
    // ==========================================
    match /leads/{leadId} {
      // READ: Super Admin can read all. Company Admin can read all company leads. Salesman reads assigned/created.
      allow read: if isAuthenticated() && isCompanyActive() && belongsToCompany(resource.data) && (
        isAdmin() ||
        resource.data.assigned_to == request.auth.uid ||
        resource.data.created_by == request.auth.uid
      );
      
      // CREATE:
      // - Must be authenticated, active, and company active
      // - created_by must match request.auth.uid
      // - Must belong to user's company
      allow create: if isAuthenticated() && isActive() && isCompanyActive() &&
                    request.resource.data.created_by == request.auth.uid &&
                    request.resource.data.company_name is string &&
                    request.resource.data.company_name.size() > 0 &&
                    belongsToCompany(request.resource.data) &&
                    (!('status' in request.resource.data) || isValidStatus(request.resource.data.status)) &&
                    (!('priority' in request.resource.data) || isValidPriority(request.resource.data.priority)) &&
                    (
                      isAdmin() ||
                      request.resource.data.assigned_to == request.auth.uid
                    );
                    
      // UPDATE:
      allow update: if isAuthenticated() && isActive() && isCompanyActive() && belongsToCompany(resource.data) && (
        isAdmin() ||
        (
          (resource.data.assigned_to == request.auth.uid || resource.data.created_by == request.auth.uid) &&
          request.resource.data.assigned_to == resource.data.assigned_to &&
          request.resource.data.created_by == resource.data.created_by &&
          (!('status' in request.resource.data) || isValidStatus(request.resource.data.status)) &&
          (!('priority' in request.resource.data) || isValidPriority(request.resource.data.priority))
        )
      );
      
      // DELETE: Admin or Super Admin can delete leads (Admin-led Lead Deletion)
      allow delete: if isAuthenticated() && isActive() && isCompanyActive() && belongsToCompany(resource.data) && isAdmin();

      // ------------------------------------------
      // Lead Subcollection: Activities
      // ------------------------------------------
      match /activities/{activityId} {
        allow read: if canAccessLead(leadId);
        
        allow create: if isAuthenticated() && isActive() && canAccessLead(leadId) &&
                      request.resource.data.created_by == request.auth.uid &&
                      (!('lead_id' in request.resource.data) || request.resource.data.lead_id == leadId);
                      
        allow update, delete: if isAuthenticated() && isActive() && isAdmin();
      }

      // ------------------------------------------
      // Lead Subcollection: Follow-ups
      // ------------------------------------------
      match /followups/{followupId} {
        allow read: if canAccessLead(leadId);
        
        allow create: if isAuthenticated() && isActive() && canAccessLead(leadId) &&
                      request.resource.data.created_by == request.auth.uid &&
                      (!('status' in request.resource.data) || isValidFollowupStatus(request.resource.data.status)) &&
                      (!('lead_id' in request.resource.data) || request.resource.data.lead_id == leadId);
                      
        allow update: if isAuthenticated() && isActive() && canAccessLead(leadId) &&
                      (!('status' in request.resource.data) || isValidFollowupStatus(request.resource.data.status));
                      
        allow delete: if isAuthenticated() && isActive() && (isAdmin() || canAccessLead(leadId));
      }

      // ------------------------------------------
      // Lead Subcollection: Assignment / Transfer History
      // ------------------------------------------
      match /transfers/{transferId} {
        allow read: if canAccessLead(leadId);
        allow create: if isAuthenticated() && isActive() && isAdmin() &&
                      request.resource.data.transferred_by == request.auth.uid;
        allow update, delete: if false;
      }

      // ------------------------------------------
      // Lead Subcollection: Attachments
      // ------------------------------------------
      match /attachments/{attachmentId} {
        allow read: if canAccessLead(leadId);
        
        allow create: if isAuthenticated() && isActive() && canAccessLead(leadId) &&
                      request.resource.data.uploaded_by == request.auth.uid &&
                      request.resource.data.file_name is string &&
                      request.resource.data.file_name.size() > 0 &&
                      (!('lead_id' in request.resource.data) || request.resource.data.lead_id == leadId);
                      
        allow update: if isAuthenticated() && isActive() && canAccessLead(leadId) &&
                      request.resource.data.uploaded_by == resource.data.uploaded_by &&
                      request.resource.data.lead_id == resource.data.lead_id;
                      
        allow delete: if isAuthenticated() && isActive() && (
          isAdmin() ||
          (canAccessLead(leadId) && (resource.data.uploaded_by == request.auth.uid || isAdmin()))
        );
      }
    }

    // ==========================================
    // 5. Root Activities Collection (/activities/{activityId})
    // ==========================================
    match /activities/{activityId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data) && (isAdmin() || resource.data.created_by == request.auth.uid || resource.data.performed_by == request.auth.uid);
      allow create: if isAuthenticated() && isActive() && request.resource.data.created_by == request.auth.uid && belongsToCompany(request.resource.data);
      allow update, delete: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);
    }

    // ==========================================
    // 6. Root Follow-ups Collection (/followups/{followupId})
    // ==========================================
    match /followups/{followupId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data) && (
        isAdmin() || 
        resource.data.assigned_to == request.auth.uid ||
        resource.data.created_by == request.auth.uid
      );
      allow create: if isAuthenticated() && isActive() && belongsToCompany(request.resource.data) && (
        isAdmin() || 
        request.resource.data.assigned_to == request.auth.uid ||
        request.resource.data.created_by == request.auth.uid
      );
      allow update: if isAuthenticated() && isActive() && belongsToCompany(resource.data) && (
        isAdmin() || 
        resource.data.assigned_to == request.auth.uid ||
        resource.data.created_by == request.auth.uid
      );
      allow delete: if isAuthenticated() && isActive() && belongsToCompany(resource.data) && (isAdmin() || resource.data.created_by == request.auth.uid);
    }

    // ==========================================
    // 7. Notifications Collection (/notifications/{notificationId})
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipient_id == request.auth.uid ||
        (isAdmin() && belongsToCompany(resource.data))
      );
      
      allow create: if isAuthenticated() && isActive() &&
                    request.resource.data.recipient_id is string &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.is_read == false;
                    
      allow update: if isAuthenticated() && isActive() && (
        isAdmin() ||
        (
          resource.data.recipient_id == request.auth.uid &&
          request.resource.data.recipient_id == resource.data.recipient_id &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.message == resource.data.message
        )
      );
      
      allow delete: if isAuthenticated() && isActive() && (
        resource.data.recipient_id == request.auth.uid ||
        (isAdmin() && belongsToCompany(resource.data))
      );
    }

    // ==========================================
    // 8. Audit Logs Collection (/audit_logs/{auditLogId})
    // ==========================================
    match /audit_logs/{auditLogId} {
      // Super Admin reads all audit logs; Company Admin reads company audit logs
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && belongsToCompany(resource.data))
      );

      // Create audit log: System / authenticated users can log actions
      allow create: if isAuthenticated() && isActive() &&
                    request.resource.data.action is string &&
                    request.resource.data.action.size() > 0 &&
                    request.resource.data.entity_type is string &&
                    request.resource.data.description is string &&
                    (
                      isAdmin() ||
                      request.resource.data.performed_by == request.auth.uid
                    );

      // Immutable audit trail: NEVER update or delete audit logs
      allow update, delete: if false;
    }

    // ==========================================
    // 9. Clients Collection (/clients/{clientId})
    // ==========================================
    match /clients/{clientId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data);

      allow create: if isAuthenticated() && isActive() && belongsToCompany(request.resource.data) &&
                    request.resource.data.company_name is string &&
                    request.resource.data.company_name.size() > 0 &&
                    request.resource.data.source_lead_id is string &&
                    request.resource.data.owner_id is string &&
                    (!('status' in request.resource.data) || request.resource.data.status in ['Active', 'Inactive']) &&
                    (
                      isAdmin() ||
                      request.resource.data.owner_id == request.auth.uid
                    );

      allow update: if isAuthenticated() && isActive() && belongsToCompany(resource.data) && (
        isAdmin() ||
        (
          resource.data.owner_id == request.auth.uid &&
          request.resource.data.owner_id == resource.data.owner_id &&
          request.resource.data.source_lead_id == resource.data.source_lead_id &&
          (!('status' in request.resource.data) || request.resource.data.status in ['Active', 'Inactive'])
        )
      );

      allow delete: if isAuthenticated() && isActive() && belongsToCompany(resource.data) && isAdmin();
    }

    // ==========================================
    // 10. Tags Collection (/tags/{tagId})
    // ==========================================
    match /tags/{tagId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data);

      allow create: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(request.resource.data) &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.type in ['Lead', 'Client', 'Both'];

      allow update: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);

      allow delete: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);
    }

    // ==========================================
    // 11. Saved Segments Collection (/saved_segments/{segmentId})
    // ==========================================
    match /saved_segments/{segmentId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data);

      allow create: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(request.resource.data) &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.entity_type in ['Lead', 'Client', 'Both'];

      allow update: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);

      allow delete: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);
    }

    // ==========================================
    // 12. Not Duplicates Dismissal Collection (/not_duplicates/{pairId})
    // ==========================================
    match /not_duplicates/{pairId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data);
      allow create, update, delete: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(request.resource.data);
    }

    // ==========================================
    // 13. Import Jobs History Collection (/import_jobs/{jobId})
    // ==========================================
    match /import_jobs/{jobId} {
      allow read, create, update, delete: if isAuthenticated() && isActive() && isAdmin() && belongsToCompany(resource.data);
    }
  }
}



